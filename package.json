{
  "name": "@cmts-dev/carmentis-desk-connect-js",
  "version": "1.2.1",
  "description": "Framework-agnostic JS SDK for connecting web applications to Carmentis Desk",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "build": "vite build"
  },
  "dependencies": {
    "@cmts-dev/carmentis-relay-client": "^1.2.0",
    "@cmts-dev/carmentis-sdk-json-rpc": "^1.0.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/qrcode": "^1.5.6",
    "@semantic-release/npm": "^13.2.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.5.3",
    "vite": "8.3.5",
    "vite-plugin-dts": "^4.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carmentis/carmentis-desk-connect-js.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
